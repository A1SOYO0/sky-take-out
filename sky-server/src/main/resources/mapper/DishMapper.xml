<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into dish(name,category_id,price,description,status,image,create_time,update_time,create_user,update_user)
            values (#{name},#{categoryId},#{price},#{description},#{status},#{image},#{createTime},#{updateTime},#{createUser},#{updateUser})
    </insert>

    <select id="pageQuery" resultType="com.sky.vo.DishVO">
        select dish.*,category.name as categoryName
        from dish left join category on dish.category_id = category.id
        <where>
            <if test="categoryId != null">and category_id= #{categoryId}</if>
            <if test="name != null">and dish.name like concat('%',#{name},'%')</if>
            <if test="status != null">and dish.status= #{status}</if>
        </where>
            order by update_time desc
    </select>
</mapper>